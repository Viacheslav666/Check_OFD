# syntax=docker/dockerfile:1
# Образ агента ОФД (для Linux/Docker на RDP клиента или для демо).
FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml .
COPY contract/pom.xml contract/pom.xml
COPY agent/pom.xml agent/pom.xml
COPY server/pom.xml server/pom.xml
COPY client/pom.xml client/pom.xml
RUN mvn -pl agent -am -B -q dependency:go-offline -DskipTests || true
COPY contract contract
COPY agent agent
RUN mvn -pl agent -am -B -DskipTests package

FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -r -u 10002 agent \
 && mkdir -p /data && chown agent /data
COPY --from=build /src/agent/target/ofd-agent-*-exec.jar /app/ofd-agent.jar
USER agent
EXPOSE 18500
VOLUME /data
ENV AGENT_PORT=18500 \
    AGENT_DATA_DIR=/data \
    OFD_MODE=mock \
    JAVA_OPTS="-Xms64m -Xmx384m -XX:+UseSerialGC"
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD curl -fsS http://127.0.0.1:18500/agent/v1/health || exit 1
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/ofd-agent.jar"]
