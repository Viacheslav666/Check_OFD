# Скопируйте в .env при необходимости: cp .env.example .env
OFD_HOST_PORT=18443
DB_PASSWORD=ofd
# Ключ доступа клиента JavaFX к центру (заголовок X-Api-Key). Пусто — без проверки.
CLIENT_API_KEY=
# Пусто — без демо-агентов (боевой режим: агентов добавляют в ЛК)
# CENTRAL_BOOTSTRAP_AGENTS=
# Ключа ОФД здесь НЕТ: он хранится в agent.yml на RDP клиента.
