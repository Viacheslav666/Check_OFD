# agent.yml — положите рядом с ofd-agent.jar на RDP клиента и заполните.
# Этот файл содержит секреты (ключ ОФД, токен): доступ к папке — только администраторам.
server:
  port: 18500            # порт, на котором агент слушает центр
  # --- необязательно: HTTPS ---
  # ssl:
  #   enabled: true
  #   key-store: agent.p12
  #   key-store-password: CHANGE_ME
  #   key-store-type: PKCS12

agent:
  name: "РДП Клиент-1"
  # Общий секрет с центром, не короче 16 символов (тот же вписывается в карточку агента в ЛК центра).
  # Если оставить пустым, агент сам сгенерирует токен в data\agent-token.txt
  token: ""
  # IP центрального приложения (через запятую; можно подсеть CIDR). С других адресов — отказ 403.
  # Изменение применяется без перезапуска (в течение ~10 с). Чтобы заодно обновить брандмауэр,
  # используйте: .\Set-AgentAllowedIps.ps1 -AllowedIps "192.168.31.196"
  allowed-ips: "192.168.31.196"
  data-dir: "./data"
  retention-days: 120

ofd:
  mode: live             # live — боевой ОФД; mock — демо-данные без ключа
  api-key: "ВСТАВЬТЕ_API_KEY_ИЗ_ЛК_ОФД"
  inn: "635001808204"    # несколько ИНН — через запятую
  sync-on-startup: true
  scheduler:
    enabled: true
    cron: "0 */15 * * * *"   # каждые 15 минут
